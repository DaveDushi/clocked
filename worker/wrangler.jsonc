{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clocked",
  "account_id": "972f8c0c21865ac5fa34b14cfb73479e",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // better-auth imports node:crypto / node:async_hooks at load, so enable Node compat.
  "compatibility_flags": ["nodejs_compat"],

  // Every minute — report fan-out checks each user's configured local schedule.
  // 14:00 UTC — marketing agent (IndexNow + site tips; optional X if secrets set).
  "triggers": { "crons": ["* * * * *", "0 14 * * *"] },
  "routes": [
    { "pattern": "clocked.daviddusi.com", "custom_domain": true },
    { "pattern": "clocked.daviddusi.com/*", "zone_name": "daviddusi.com" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clocked",
      "database_id": "75d62c93-4892-46e8-a1aa-e11b6cf0941d",
      "migrations_dir": "migrations"
    }
  ],

  // For Cloudflare Email Sending, onboard MAIL_FROM's domain, then uncomment:
  // "send_email": [{ "name": "EMAIL" }],

  "vars": {
    // resend (default), cloudflare, or ses. See README for setup.
    "EMAIL_PROVIDER": "resend",
    "REPORT_TZ": "America/New_York",
    // Legacy fallback only; per-user mail_to / account email is preferred.
    "MAIL_TO": "",
    "MAIL_FROM": "timesheet@clocked.daviddusi.com",
    // Public base URL of this worker (used by better-auth for the dashboard login).
    "BETTER_AUTH_URL": "https://clocked.daviddusi.com"
  }

  // Secrets (do NOT put in vars):
  //   wrangler secret put BETTER_AUTH_SECRET   # 32+ random chars
  //   wrangler secret put RESEND_API_KEY       # Required when EMAIL_PROVIDER=resend
  // SES: set SES_REGION in vars and these secrets when EMAIL_PROVIDER=ses:
  //   wrangler secret put SES_ACCESS_KEY_ID
  //   wrangler secret put SES_SECRET_ACCESS_KEY
  //   wrangler secret put SES_SESSION_TOKEN  # optional, for temporary credentials
  // Optional Google OAuth:
  //   wrangler secret put GOOGLE_CLIENT_ID
  //   wrangler secret put GOOGLE_CLIENT_SECRET
  // Legacy single-user bearer (off by default; only with ALLOW_LEGACY_BEARER_TOKEN=true):
  //   wrangler secret put BEARER_TOKEN
  // Marketing agent (optional X posting + manual run trigger):
  //   wrangler secret put MARKETING_AGENT_SECRET
  //   wrangler secret put X_API_KEY
  //   wrangler secret put X_API_SECRET
  //   wrangler secret put X_ACCESS_TOKEN
  //   wrangler secret put X_ACCESS_TOKEN_SECRET
  // For local dev these live in worker/.dev.vars (gitignored).
}
